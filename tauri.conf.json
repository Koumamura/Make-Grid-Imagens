
{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miau tools",
  "version": "0.1.0",
  "identifier": "com.tauri.miautool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Miau tools",
        "width": 1000,
        "height": 800,
        "resizable": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "scope": ["**"],
      "permissions": ["all"]
    },
    "dialog": {
      "permissions": ["all"]
    }
  }
}
